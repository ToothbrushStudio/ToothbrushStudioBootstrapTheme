{
  "name": "@toothbrushstudio/bootstrap-theme",
  "version": "0.1.0",
  "description": "Toothbrush Studio — a playful-dental Bootstrap 5 theme. The default theme for Chomponents.",
  "license": "MIT",
  "author": "Toothbrush Studio, LLC",
  "homepage": "https://github.com/ToothbrushStudio/ToothbrushStudioBootstrapTheme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToothbrushStudio/ToothbrushStudioBootstrapTheme.git"
  },
  "bugs": {
    "url": "https://github.com/ToothbrushStudio/ToothbrushStudioBootstrapTheme/issues"
  },
  "keywords": [
    "bootstrap",
    "bootstrap-theme",
    "theme",
    "scss",
    "sass",
    "css",
    "toothbrush-studio",
    "chomponents"
  ],
  "main": "dist/toothbrush.css",
  "style": "dist/toothbrush.min.css",
  "sass": "scss/toothbrush.scss",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scss"
  ],
  "exports": {
    ".": "./dist/toothbrush.min.css",
    "./css": "./dist/toothbrush.css",
    "./scss": "./scss/toothbrush.scss",
    "./scss/*": "./scss/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "sass scss/toothbrush.scss dist/toothbrush.css --style=expanded --no-source-map --load-path=node_modules --quiet-deps && sass scss/toothbrush.scss dist/toothbrush.min.css --style=compressed --no-source-map --load-path=node_modules --quiet-deps",
    "prefix": "postcss dist/toothbrush.css dist/toothbrush.min.css --replace --no-map",
    "build": "npm run clean && npm run compile && npm run prefix",
    "watch": "sass --watch scss/toothbrush.scss:dist/toothbrush.css --style=expanded --load-path=node_modules --quiet-deps",
    "test": "node test/assert-dist.mjs"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "autoprefixer": "10.4.20",
    "bootstrap": "5.3.3",
    "postcss": "8.4.47",
    "postcss-cli": "11.0.0",
    "rimraf": "6.0.1",
    "sass": "1.77.8"
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 major versions",
    "not dead",
    "Chrome >= 60",
    "Firefox >= 60",
    "Firefox ESR",
    "iOS >= 12",
    "Safari >= 12",
    "not Explorer <= 11"
  ]
}
